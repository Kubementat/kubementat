{
  "images": [
    {
      "name": "ubuntu",
      "description": "ubuntu base Image for the cli automation image",
      "source": "ubuntu:24.04",
      "destination": "REPLACEME_DOCKER_REGISTRY_BASE_URL/ubuntu:24.04"
    },
    {
      "name": "terraform",
      "description": "Image used for terraform tasks",
      "source": "hashicorp/terraform:latest",
      "destination": "REPLACEME_DOCKER_REGISTRY_BASE_URL/terraform:latest"
    },
    {
      "name": "buildkit",
      "description": "Image used for building docker images: the rootless BuildKit the build task runs. Tag is v0.34.2, whose manifest list is sha256:c8252268760e1baba80780d63d738ef9f260fb7c7c0973c78494cb9ddd99eda1, so a mirrored pull resolves to the same bytes the upstream tag does",
      "source": "moby/buildkit:v0.34.2-rootless",
      "destination": "REPLACEME_DOCKER_REGISTRY_BASE_URL/buildkit:v0.34.2-rootless"
    },
    {
      "name": "traefik",
      "description": "Traefik Proxy, the ingress controller kubementat installs. Tag is the appVersion of helmfile's pinned traefik/traefik 42.1.3, which is the tag `helm template` renders for that chart",
      "source": "traefik:v3.7.16",
      "destination": "REPLACEME_DOCKER_REGISTRY_BASE_URL/traefik:v3.7.16"
    }
  ]
}