# Full Component Helm configuration for the environment
# apply via:
# helm plugin install https://github.com/databus23/helm-diff
# export ENVIRONMENT="dev"
# helmfile apply --interactive -f helmfile.yaml
#
# grafana's admin credentials are not set here: `platform_config/${ENVIRONMENT}/static.encrypted.json`
# is their source of truth, and kubementat's own `kmt helm apply` / `kmt install` read that file
# and export GRAFANA_ADMIN_USER and GRAFANA_ADMIN_PASSWORD before helmfile runs. Exporting them by
# hand only asks for two answers to one question, and kubementat's answer is the one grafana is
# built from. Both halves are required, by this file and not only by kubementat: `requiredEnv` appears
# twice below, so a tree missing either one aborts the whole helmfile file rather than skipping grafana.
# kubementat therefore refuses before applying anything and names the file, which is the sentence
# `requiredEnv` cannot give you -- it reports a variable and a line number, and neither is a
# configuration path. `config init` generates the password where nothing answers it, so the trees that
# reach this refusal are the ones where somebody took it away.

# for filtering by labels
# helmfile apply --interactive -f helmfile.yaml -l component=monitoring
# or
# helmfile apply --interactive -f helmfile.yaml -l group=standard
# or
# helmfile sync --interactive -f helmfile.yaml -l group=standard

#
# Release namespaces are not written here. Where a release lands is decided by the same file
# that decides where a tunnel looks for it: `HelmUtils.helmfile_apply` exports
# `<COMPONENT>_DEPLOYMENT_NAMESPACE` out of `platform_config/{environment}/static.json` before
# helmfile runs, and the releases below read that variable through `default`, whose argument
# is kubementat's built-in fallback (`src/kubementat/constants.py`). One value, decided once:
# renaming the key moves the release, and a key that is not set changes nothing instead of
# failing the apply.
#
# No release below keeps a literal namespace. The three git-provider releases that did were
# retired on 2026-10-29 and took their chart repositories with them, so no git server is
# kubementat's to place any more, and every release this file declares reads its namespace from
# the exported variable. Any exception would be listed in
# `tests/test_component_namespaces_come_from_configuration.py`, which fails if the list and the
# file ever disagree; the list is empty, which is the honest answer and the one that holds.

#
# For full file format documentation see: https://helmfile.readthedocs.io/en/latest/#getting-started

# Helm default configuration
helmDefaults:
  # verify the chart before upgrading (only works with packaged charts not directories) (default false)
  verify: false
  # wait for k8s resources via --wait. (default false)
  wait: true
  # if set and --wait enabled, will wait until all Jobs have been completed before marking the release as successful. It will wait for as long as --timeout (default false, Implemented in Helm3.5)
  waitForJobs: true
  # time in seconds to wait for any individual Kubernetes operation (like Jobs for hooks, and waits on pod/pvc/svc/deployment readiness) (default 300)
  timeout: 600
  # limit the maximum number of revisions saved per release. Use 0 for no limit. (default 10)
  historyMax: 10
  # when using helm 3.2+, automatically create release namespaces if they do not exist (default true)
  createNamespace: true
  # if used with charts museum allows to pull unstable charts for deployment, for example: if 1.2.3 and 1.2.4-dev versions exist and set to true, 1.2.4-dev will be pulled (default false)
  devel: false

# REPOs
repositories:
# Polaris is out of the comment rather than still in it. The alias is `fairwinds-stable` and not
# `polaris` for the reason every other alias here is named for its publisher: helmfile resolves a
# chart by the alias name, so the commented block this replaced read `name: polaris` in `repositories`
# and `chart: fairwinds-stable/polaris` in `releases` -- two namings for one repository, and uncommenting
# the pair as written asked for a repository the file never declared. The publisher's name is also the
# fact a reader needs when the publisher moves, which is what `grafana`/`grafana-community` above is
# carrying. The commented alias is deleted rather than left behind, the same way `sstarcher`'s retired
# neighbours were: a repository no release points at still costs a fetch on every `helmfile repos`.
- name: fairwinds-stable
  url: https://charts.fairwinds.com/stable
- name: grafana
  url: https://grafana.github.io/helm-charts
# The community fork that carries grafana and loki now. The vendor repository above froze on
# 2026-01-30, and the newest `grafana` release it still serves is marked `deprecated: true`, so there
# is no current chart to read there any more and `grafana` is installed from this one.
#
# The alias above is not retired, and two grafana repositories are not an accident to tidy away.
# This fork publishes seven charts - grafana, grafana-mcp, loki, synthetic-monitoring-agent, tempo,
# tempo-distributed and tempo-vulture - and `alloy` is not one of them. So after 2026-10-31 the two
# aliases are read by opposite halves of log aggregation: `grafana-community` serves `grafana` and
# `loki`, and the vendor alias serves `alloy`, which Grafana Labs still maintains themselves.
# Neither alias may be repointed. Doing it to the vendor one asks for a chart that does not exist and
# uninstalls the collector; doing it to the fork would move `loki` off the chart that is maintained
# for it. The vendor index does still serve `loki` 7.5.0 and `loki-stack` 2.10.3, but the first is
# the Enterprise Logs chart on seven majors of Loki behind the fork, and the second is the bundle
# this release block replaced, marked `deprecated: true`.
- name: grafana-community
  url: https://grafana-community.github.io/helm-charts
- name: prometheus-community
  url: https://prometheus-community.github.io/helm-charts
# The metrics-exporter repository is gone rather than parked in a comment. It froze at 2.13.3, the
# chart was marked `deprecated: true` in 2021, and the exporter arrives as a subchart of the
# `prometheus-community/prometheus` release below now, so there is no standalone chart left to read
# and no release that would read one. A repository no release points at is not a harmless
# placeholder: `helmfile repos` fetches every entry in this block before any label filter is
# consulted, so a retired chart costs a network round trip and a state file for software kubementat
# will never install.
- name: sstarcher
  url: https://shanestarcher.com/helm-charts/
# Traefik, the ingress controller. The owner decided on 2026-10-28 that nginx-ingress goes out and
# Traefik takes the routing role, so the repository the release block below reads is here. The
# companion `traefik-crds` chart is not: it is deprecated since chart v38.0.2 and ships no proxy,
# and `traefik/traefik` carries its own `crds/`.
- name: traefik
  url: https://traefik.github.io/charts
- name: jetstack
  url: https://charts.jetstack.io
# The repository Vault's chart lived in is gone rather than left commented, for the reason spelled
# out above the `sstarcher` line: `helmfile repos` fetches every alias in this block before any
# label filter is consulted, so an alias no release reads costs a round trip and a state file for a
# chart kubementat no longer installs.
- name: openbao
  url: https://openbao.github.io/openbao-helm
# Mail, cluster DNS, and a kanban board left the platform's scope and took their repositories with
# them, the way the three git providers did. The cost is the one spelled out above the `sstarcher`
# line: all three indexes were fetched on every `helmfile repos` run for releases this file no longer
# declares, and none of the three is waiting on a version bump. Each is out of scope rather than
# deferred, and for its own reason.
#
# Mail is not platform scope. kubementat does not operate a mail server for a cluster, and the
# release block that asked for one never had an exported namespace variable to read, which is the
# tell that it was a proposal and not a component.
#
# Cluster DNS is out for the harder reason: k3s and every other distribution ship CoreDNS with the
# cluster, so a second copy installed into `kube-system` would fight the node's own resolver, and no
# values file settles that fight.
#
# The kanban board is out because it is third-party software of the ordinary kind. What a team wants
# from it it can have the way it wants it from anything else third-party: its own helm release, its
# own values file, applied by whoever wants it. kubementat neither installs nor uninstalls that.

# ---------------------------------------------------------------------------
# The operator's own values layers, spelled once (spec R-4.2 and R-4.5).
#
# Every release below reads the same four candidate files after its packaged
# default, and the order is the whole rule: the product's shipped default first,
# then the environment's plain file, then the environment's encrypted file, then
# the team's plain file and the team's encrypted file when a team is named. helm
# merges `-f` arguments in the order they arrive, so the last file that declares a
# key is the answer -- the same layering `kmt config` applies to `static.json`, on
# the two directories §5's layout names:
# `<config>/<environment>/values/<component>.yaml`, `.../values.encrypted/<component>.yaml`,
# and the same two under `.../<environment>/<team>/`.
#
# `<component>` is the release's `component_name` label, because that is the name
# `kmt component install` addresses the release by. Not the chart and not the
# release name: the two prometheus exporters share a namespace and a chart family,
# and `polaris` is `polaris` while its `component` label says `analytics`.
#
# Two things make this addressable from inside a wheel, and both were measured on
# helmfile 1.7.0 rather than read off the syntax:
#
# * No path here names the checkout. `KUBEMENTAT_CONFIG_ROOT`, `KUBEMENTAT_ENVIRONMENT`
#   and `KUBEMENTAT_TEAM` are exported by `helm_utils.export_configuration_coordinates`
#   before helmfile starts, which is why a run that names no team gets no team layer
#   (`env` of an unset variable answers ""; it is not an error). A hand-run `helmfile`
#   in this directory exports none of them, so it applies exactly the shipped
#   defaults and says nothing about a configuration tree it was never told about.
# * Absent is cheap and present is correct, but NOT through `missingFileHandler`.
#   helmfile 1.7.0 has no per-entry handler: a values entry written as a mapping is
#   read as inline values, so `- missingFileHandler: Warn` would put that word and a
#   `values:` key into the chart's values and still fail the apply on the missing
#   file. A release-level handler would work, but it would also silence a missing
#   *product* default -- a shipped file that moved or lost its suffix would install
#   chart defaults while the manifest looked satisfied. So each operator entry is
#   guarded by `isFile` instead and helmfile's own Error handler is left alone: a
#   file that is not there is not listed, so it cannot warn and cannot be applied,
#   and a file the manifest does list is a file the operator wrote.
{{- define "kubementat-operator-values" }}
{{- $root := env "KUBEMENTAT_CONFIG_ROOT" }}
{{- $env := env "KUBEMENTAT_ENVIRONMENT" }}
{{- if and $root $env }}
{{- if isFile (printf "%s/%s/values/%s.yaml" $root $env .) }}
    - {{ printf "%s/%s/values/%s.yaml" $root $env . }}
{{- end }}
{{- if isFile (printf "%s/%s/values.encrypted/%s.yaml" $root $env .) }}
    - {{ printf "%s/%s/values.encrypted/%s.yaml" $root $env . }}
{{- end }}
{{- $team := env "KUBEMENTAT_TEAM" }}
{{- if $team }}
{{- if isFile (printf "%s/%s/%s/values/%s.yaml" $root $env $team .) }}
    - {{ printf "%s/%s/%s/values/%s.yaml" $root $env $team . }}
{{- end }}
{{- if isFile (printf "%s/%s/%s/values.encrypted/%s.yaml" $root $env $team .) }}
    - {{ printf "%s/%s/%s/values.encrypted/%s.yaml" $root $env $team . }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}

# Releases configuration for deployments
releases:
# Monitoring
- name: prometheus
  # 29.40.1 is Prometheus v3.15.1, re-read from the community index on 2026-10-31. The commented
  # 18.1.0 it replaces was Prometheus 2.39.1 from 2022, and this release carried no pin at all, so a
  # fresh install resolved to whatever the index served that day. The chart is on Prometheus 3 now;
  # both keys kubementat sets (`extraScrapeConfigs`, `prometheus-node-exporter.enabled`) exist in
  # 29.40.1 and `helm template` renders our values file against it without error.
  chart: prometheus-community/prometheus
  installed: {{ env "PROMETHEUS_ENABLED" | default "true" }}
  version: "{{ env "PROMETHEUS_VERSION" | default "29.40.1" }}"
  namespace: {{ env "PROMETHEUS_DEPLOYMENT_NAMESPACE" | default "prometheus" }}
  labels:
    component: monitoring
    component_name: prometheus
    group: standard
  # as the prometheus-server pod will fail while starting up when not configured for ha mode (see https://github.com/prometheus-community/helm-charts/blob/main/charts/prometheus/values.yaml#L1044)
  # recreatePods: true
  # force: true
  values:
    - monitoring/prometheus_values.yaml
    {{- template "kubementat-operator-values" "prometheus" }}

- name: prometheus-blackbox-exporter
  # 11.20.2 is exporter v0.29.1, re-read from the community index on 2026-10-31. The commented 7.1.3
  # was v0.22.0. Our values file sets one key, `replicas`, and it is present in both 7.1.3 and
  # 11.20.2 defaults, and renders. The 7 -> 11 majors did drop the Role/RoleBinding the old chart
  # created beside the Deployment, which is a chart decision and not a values key of ours.
  chart: prometheus-community/prometheus-blackbox-exporter
  installed: {{ env "PROMETHEUS_BLACKBOX_EXPORTER_ENABLED" | default "true" }}
  version: "{{ env "PROMETHEUS_BLACKBOX_EXPORTER_VERSION" | default "11.20.2" }}"
  namespace: {{ env "PROMETHEUS_DEPLOYMENT_NAMESPACE" | default "prometheus" }}
  labels:
    component: monitoring
    component_name: prometheus-blackbox-exporter
    group: standard
  values:
    - monitoring/prometheus_blackbox_exporter_values.yaml
    {{- template "kubementat-operator-values" "prometheus-blackbox-exporter" }}

- name: prometheus-helm-exporter
  # 1.4.0+e2eee28 is app 1.4.0, re-read from the index on 2026-10-31. The `+e2eee28` suffix is the
  # chart's own build metadata and is part of the version string the index serves: it is quoted here
  # because unquoted it is not a string, and it is kept because it is what `helm pull` resolves.
  # Our values file sets `replicaCount`, which 1.4.0 still documents.
  chart: sstarcher/helm-exporter
  installed: {{ env "PROMETHEUS_HELM_EXPORTER_ENABLED" | default "true" }}
  version: "{{ env "PROMETHEUS_HELM_EXPORTER_VERSION" | default "1.4.0+e2eee28" }}"
  namespace: {{ env "PROMETHEUS_DEPLOYMENT_NAMESPACE" | default "prometheus" }}
  labels:
    component: monitoring
    component_name: prometheus-helm-exporter
    group: standard
  values:
    - monitoring/prometheus_helm_exporter_values.yaml
    {{- template "kubementat-operator-values" "prometheus-helm-exporter" }}

- name: grafana
  # 14.2.0 is Grafana 13.3.0. It comes from the community fork for the reason the repositories
  # section spells out; `loki` keeps the vendor alias and is untouched by this line.
  chart: grafana-community/grafana
  installed: {{ env "GRAFANA_ENABLED" | default "true" }}
  version: "{{ env "GRAFANA_VERSION" | default "14.2.0" }}"
  namespace: {{ env "GRAFANA_DEPLOYMENT_NAMESPACE" | default "grafana" }}
  labels:
    component: monitoring
    component_name: grafana
    group: standard
  values:
    - monitoring/grafana_values.yaml
    - adminUser: {{ requiredEnv "GRAFANA_ADMIN_USER" | quote }}
    - adminPassword: {{ requiredEnv "GRAFANA_ADMIN_PASSWORD" | quote }}
    {{- template "kubementat-operator-values" "grafana" }}

# Log aggregation: storage and query. 20.2.0 is Loki 3.7.9, re-read from the community index on
# 2026-10-31. loki-stack -- the release block this replaces -- is not deprecated so much as frozen:
# 2.10.3 shipped Loki 2.10 and Promtail, and Promtail's end of life came on 2026-03-02. The pin is
# the usual argument, but the values file underneath it is not a casualty of the pin: `helm template`
# rejects the old loki-stack values file outright (`additional properties 'promtail' not
# allowed`, and `/loki/config: got object, want string`), so there was nothing to carry forward.
#
# Two decisions are visible in this block and both are the owner's, made before this line was written.
#
# **The release name stays `loki`.** Loki 20.x names its Services after the release plus the
# component, so monolithic mode puts a ClusterIP called `loki` on port 3100 that selects the
# single-binary StatefulSet. The Grafana datasource this platform provisions --
# `monitoring/grafana_values.yaml`, `url: http://loki.loki.svc.cluster.local:3100`
# -- is a hard fact about that address, and no unit test in this repository can see it break. So the
# name is load-bearing, `gateway.enabled` stays `false` (the gateway would answer on 80 under a
# different name), and `helm template` was read rather than assumed: at 20.2.0 with the values file
# this release points at, the rendered objects are `loki`, `loki-headless`, `loki-memberlist` and a
# StatefulSet `loki` whose only container args end in `-target=all`.
#
# **Retention is written where this chart enforces it.** `limits_config.retention_period: 336h` and
# `compactor.retention_enabled: true` both land in the rendered `loki.yaml`, and `-target=all` runs
# the compactor inside the single binary, which is what applies it. `table_manager` and
# `chunk_store_config` are gone: they were Loki 2.x keys, the chart emits them only from the
# top-level `tableManager` block (a separate Deployment this install does not want), and putting
# them anywhere else is a retention setting that means nothing while still being trusted.
- name: loki
  chart: grafana-community/loki
  installed: {{ env "LOKI_ENABLED" | default "true" }}
  version: "{{ env "LOKI_VERSION" | default "20.2.0" }}"
  namespace: {{ env "LOKI_DEPLOYMENT_NAMESPACE" | default "loki" }}
  labels:
    component: logging
    component_name: loki
    group: standard
  values:
    - logging/loki_values.yaml
    {{- template "kubementat-operator-values" "loki" }}

# Log collection: Alloy as a DaemonSet, shipping container logs and Kubernetes events to Loki. The
# collector is a release of its own rather than a subchart because the community loki chart has no
# subchart to be it -- loki-stack bundled Promtail and that was the whole of its collection story.
#
# **Why alloy lands in `loki` and not in a namespace called `alloy`.** `kmt uninstall` sweeps
# namespaces out of `constants.DEFAULT_NAMESPACES` and deletes the releases it finds in them; it
# decides what is kubementat's by walking that component set, not by reading this file. A namespace
# that is not in that map is therefore not swept -- `assert:no-extra-namespaces` would notice once,
# and after that an Alloy DaemonSet would keep running on every node of a cluster that has been torn
# down. The alternative is a constants entry, a `static.json.template` key and a namespace that
# belongs to no other component; that buys nothing and costs one omission, which is a silent and
# permanent residue. Sharing `loki` costs nothing at all: the same `LOKI_DEPLOYMENT_NAMESPACE` key
# moves both releases, so a rename cannot split a collector from the store it writes to, and
# deleting the namespace takes Alloy with it -- a path the lane's uninstall stage already proves.
#
# **No `needs:`.** helmfile resolves dependencies inside the selected set, and `kmt component
# install alloy` applies `-l component_name=alloy` with nothing else selected, so a `needs: loki`
# line would make that command refuse. Declaration order and helm's own readiness wait give the
# ordering that matters; an Alloy that starts a second early simply retries its push.
#
# 1.15.0 is Alloy v1.21.3, re-read from the vendor index on 2026-10-31. It reads the `grafana` alias
# and not the fork: the community repository publishes seven charts and Alloy is not among them,
# which is why both aliases are still in the `repositories` block below.
- name: alloy
  chart: grafana/alloy
  installed: {{ env "ALLOY_ENABLED" | default "true" }}
  version: "{{ env "ALLOY_VERSION" | default "1.15.0" }}"
  namespace: {{ env "LOKI_DEPLOYMENT_NAMESPACE" | default "loki" }}
  labels:
    component: logging
    component_name: alloy
    group: standard
  values:
    - logging/alloy_values.yaml
    {{- template "kubementat-operator-values" "alloy" }}

# Cluster Analysis
# Polaris returns on 2026-11-01 as a declared release, from the commented block that had stood in its
# place since the chart was last read. Three things are different from that block, and each is here
# because the comment hid it.
#
# **The chart is pinned.** 6.0.1 is Polaris 10.2.4, re-read from the `fairwinds-stable` index on
# 2026-10-31. The commented `# version: "5.6.1"` was Polaris 6 from 2022 and was not in force, so a
# fresh install resolved to whatever the index served that day -- the same defect the prometheus and
# cert-manager blocks above record.
#
# **The chart reference names the alias the file declares.** `fairwinds-stable/polaris` is read against
# the `fairwinds-stable` repository above, and that agreement is what the commented pair did not have.
#
# **The namespace comes from configuration.** `POLARIS_DEPLOYMENT_NAMESPACE` is exported by
# `HelmUtils.helmfile_apply` and defaulted here to `constants.py`' value, like every other release.
# The commented block hardcoded `polaris`, which is the one shape this file's header rules out.
#
# The `webhook.enable: false` in the values file is kept, and is not redundant: the chart's own default
# is `false` today, so a validating webhook is not currently in play, and an operator who edits this
# release is one upstream default-flip away from having a webhook able to reject the lane's own
# workloads. Being explicit is the difference between that being upstream's decision and ours.
- name: polaris
  chart: fairwinds-stable/polaris
  installed: {{ env "POLARIS_ENABLED" | default "true" }}
  version: "{{ env "POLARIS_VERSION" | default "6.0.1" }}"
  namespace: {{ env "POLARIS_DEPLOYMENT_NAMESPACE" | default "polaris" }}
  labels:
    component: analytics
    component_name: polaris
    group: standard
  values:
    - polaris/values.yaml
    {{- template "kubementat-operator-values" "polaris" }}

# Routing & certificates
# v1.21.3 is cert-manager v1.21.3, re-read from the jetstack index on 2026-10-31. The commented
# v1.10.1 it replaces is cert-manager from 2022, and this release carried no pin at all, so a fresh
# install resolved to whatever the index served that day. The chart is not deprecated -- the one
# `deprecated: true` entry in the jetstack index belongs to `cert-manager-trust`, renamed into
# `trust-manager`, and `cert-manager` itself is still maintained and CNCF-graduated -- and v1.21.3 is
# the newest entry the index returns today, so the pin did not move again. Its `kubeVersion`
# (`>= 1.22.0-0`, `helm show chart --version v1.21.3`) clears every cluster kubementat targets. Both
# keys our values file sets exist in it: `crds.enabled` and `crds.keep` (`values.yaml:106-116`), and
# `helm template` renders them against this chart with all six CRDs in the output. See
# `.agent-work/comp-3-cert-manager-report.md` for the key swap, including what `installCRDs` still
# does and why writing both forms was not chosen.
- name: cert-manager
  chart: jetstack/cert-manager
  installed: {{ env "CERT_MANAGER_ENABLED" | default "true" }}
  version: "{{ env "CERT_MANAGER_VERSION" | default "v1.21.3" }}"
  namespace: {{ env "CERT_MANAGER_DEPLOYMENT_NAMESPACE" | default "cert-manager" }}
  labels:
    component: routing
    component_name: cert-manager
    group: routing
  values:
    - routing/cert_manager.yaml
    {{- template "kubementat-operator-values" "cert-manager" }}

# The ingress controller that took the routing role when nginx-ingress came out on 2026-10-28.
# The class it installs is named in `static.json`, not here, because a cluster that already runs a
# controller has to be able to rename this one without editing a template. Helm applies this
# chart's `crds/` on install and never upgrades them, which is what `kmt routing install --update`
# says out loud rather than fixing quietly.
#
# The `version:` below is the owner's decision of 2026-10-29
# (`docs/plans/finish-python-migration-last-lap.md` §3.3, `docs/plans/traefik-integration.md` §9.2), and
# a commented-out number was not it: helm resolves "newest" against this chart's own
# `kubeVersion: >=1.30.0-0` floor, so an unpinned release installs a chart that was not reviewed against
# the values file above -- and chart 42's root `values.schema.json` sets `additionalProperties: false`, so
# one renamed key turns `helmfile apply -l group=routing` into a release that installs nothing. It is also
# what makes the image mirror in `mirrored_docker_images.json` a guarantee and not a preference: the
# mirrored tag is the chart's `appVersion`, and an unpinned chart gives that tag no fixed answer.
# 42.1.3 is the version the values template's header says it was validated against, and it is the newest
# 42.x in the traefik repository as this was written.
#
# The `ingressClass.name` line below carries no `default` of its own, and that is T-31's whole change
# rather than a tidy-up. It used to say `default "traefik"` here, which looked harmless while
# `constants.py` said the same word and was a second owner of the answer while it lasted: nothing in
# `src/` exported `TRAEFIK_INGRESS_CLASS` into this process's environment, so `env` found no variable,
# the `default` fired on every run, and a tree that declared a class of its own got a release
# configured with `traefik` and an Ingress written with its own. The answer is exported now by
# `helm_utils.export_ingress_class`, on the same path the namespaces and the release knobs take, and a
# second `default` here would fire only when that export breaks -- the failure that looks like success.
# If the variable is ever missing, what helmfile builds is what the missing answer looks like and not a
# class nobody chose, which is the honest shape of that bug and the reason no fallback lives here.
- name: traefik
  chart: traefik/traefik
  installed: {{ env "TRAEFIK_ENABLED" | default "true" }}
  version: "{{ env "TRAEFIK_VERSION" | default "42.1.3" }}"
  namespace: {{ env "TRAEFIK_DEPLOYMENT_NAMESPACE" | default "traefik" }}
  labels:
    component: routing
    component_name: traefik
    group: routing
  values:
    - traefik/values.yaml
    - ingressClass:
        name: {{ env "TRAEFIK_INGRESS_CLASS" | quote }}
    {{- template "kubementat-operator-values" "traefik" }}

# On cluster secret management
#
# Vault left kubementat over a licence and not a defect: HashiCorp moved Vault to the Business Source
# License 1.1 with 2.x, which is not a free-software licence an operator can redistribute or fork
# under, and the project sits with IBM, while OpenBao is the MPL-2.0 fork under the Linux Foundation
# that keeps the same API and the same chart shape. A platform that states free-and-open software and
# no vendor lock-in as its values cannot ship the one release whose licence says otherwise, so the
# fork is the component and there is no `vault` alias kept back "just in case".
#
# 0.30.6 is OpenBao v2.7.2, re-read from the OpenBao index on 2026-10-31. It is the newest entry that
# index returns, and the pin is the same argument the traefik block above makes: unpinned, helm
# resolves "newest" against this chart's own `kubeVersion: >=1.30.0-0` floor and the values file gets
# judged against a chart nobody read. `helm show values` answers 0.30.6 for every key our values file
# writes, so the fork's renames (`ui.activeVaultPodOnly` to `ui.activeOpenbaoPodOnly`,
# `global.externalVaultAddr` to `global.externalBaoAddr`) are not keys we carry.
- name: openbao
  chart: openbao/openbao
  installed: {{ env "OPENBAO_ENABLED" | default "true" }}
  version: "{{ env "OPENBAO_VERSION" | default "0.30.6" }}"
  namespace: {{ env "OPENBAO_DEPLOYMENT_NAMESPACE" | default "openbao" }}
  labels:
    component: secret_management
    component_name: openbao
    group: extra
  values:
    - openbao/values.yaml
    {{- template "kubementat-operator-values" "openbao" }}

# The git-provider releases were retired as kubementat components on 2026-10-29, so the `extra`
# group here is `openbao` and nothing else. The group is not an accident of history: `extra` is what
# keeps this release out of a default install and out of every lane's `install_groups`, which is why
# the harness's tunnel row for it is and stays a negative case. What a team wants from a git server it
# can have the way it wants anything from third-party software: its own helm release, its own values
# file, its own name, applied by whoever wants it. kubementat neither installs nor uninstalls that
# release.

